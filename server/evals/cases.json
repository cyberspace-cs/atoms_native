    "base_code": "<!DOCTYPE html><html><body><h1>记账</h1><input id=amt placeholder=金额><select id=type><option>收入</option><option>支出</option></select><button id=add>记</button><ul id=list></ul><script>let r=JSON.parse(localStorage.getItem('rec')||'[]');function d(){document.getElementById('list').innerHTML=r.map(x=>`<li>${x.type} ${x.amt}</li>`).join('');document.title=r.reduce((s,x)=>s+(x.type==='收入'?+x.amt:-x.amt),0)}document.getElementById('add').onclick=()=>{r.push({type:document.getElementById('type').value,amt:+document.getElementById('amt').value});localStorage.setItem('rec',JSON.stringify(r));d()};d()</script></body></html>",

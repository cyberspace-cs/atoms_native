# ===== LLM =====
# 默认厂商：deepseek（在 server/.env 中填写 key 即生效）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# 可选：OpenAI 兼容厂商（如通义千问 DashScope）
# 通义千问示例：
# OPENAI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPAT_API_KEY=sk-xxxx
# OPENAI_COMPAT_MODEL=qwen-plus
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ===== 数据库 =====
DB_PATH=./atoms_native.db

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# 每个 token 每小时最多生成次数（保护额度）
RATE_LIMIT=20

# ===== 限流（server/ratelimit.py）=====
# 留空则退回进程内令牌桶（单进程有效，多 worker 会失效）；
# 生产建议装 redis-server 并填 redis://localhost:6379/0，启用分布式令牌桶 + 跨进程互斥。
REDIS_URL=
# enforce=真正拦截 429 | shadow/draft=只观测不拦截（灰度用）| off=关闭
RATELIMIT_MODE=enforce
# 临时覆盖各接口容量（0=不覆盖，用 ENDPOINT_RATES 默认值）
RATELIMIT_CAPACITY=0

# ===== 可观测性（server/observability.py）=====
# 需 pip install opentelemetry-api==1.21.0 opentelemetry-sdk==1.21.0
# 注意：opentelemetry.semconv.trace 在 1.21.0 之后被移除，装新版会静默降级为 no-op span。
# /api/metrics 的 observability.otel_enabled 可查看是否真的生效。

# ===== 审计（server/audit.py，SOC 2 WORM 哈希链）=====
# AUDIT_WORM_PATH=./audit_trail.log
# AUDIT_RETENTION_DAYS=365

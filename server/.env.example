# ===== LLM =====
# 默认厂商：deepseek（在 server/.env 中填写 key 即生效）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# 可选：OpenAI 兼容厂商（如通义千问 DashScope）
# 通义千问示例：
# OPENAI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPAT_API_KEY=sk-xxxx
# OPENAI_COMPAT_MODEL=qwen-plus
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ===== 数据库 =====
DB_PATH=./atoms_native.db

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# 每个 token 每小时最多生成次数（保护额度）
RATE_LIMIT=20
